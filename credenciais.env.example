# Credenciais do bot do Telegram.
# Copie para `credenciais.env` e preencha. NUNCA versione o arquivo real.

# 1) Crie o bot no Telegram: abra @BotFather -> /newbot -> ele devolve o token.
TELEGRAM_BOT_TOKEN=123456789:AAExemploTokenQueNaoFuncionaTroquePeloSeu

# 2) Abra o bot, mande qualquer mensagem e pegue seu id em
#    https://api.telegram.org/bot<TOKEN>/getUpdates  (campo chat.id).
#    Só este chat consegue disparar tarefas — trava de segurança.
TELEGRAM_CHAT_ID=000000000
